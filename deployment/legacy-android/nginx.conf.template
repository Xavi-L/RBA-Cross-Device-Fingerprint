# Include inside nginx's http {} after replacing the domain and file paths.
# The certificate must have a full chain trusted by the actual legacy browsers.
server {
    listen 443 ssl;
    server_name collect.example.com;

    ssl_certificate /etc/hybridguard/tls/fullchain.pem;
    ssl_certificate_key /etc/hybridguard/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384;

    # Copy only browser_probe_site/public here, never the repository or collected data.
    root /srv/hybridguard/browser-probe;
    client_max_body_size 10m;
    add_header Referrer-Policy no-referrer always;

    location = / {
        try_files /browser-probe.html =404;
    }
    location ~ ^/(browser-probe\.html|browser-probe-bootstrap\.js|browser-probe-adapter\.js|probe/(canonical_web_probe\.js|manifest\.json))$ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        add_header Referrer-Policy no-referrer always;
    }

    location ~ ^/(health|api/collect/readiness)$ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ~ ^/api/collect/(fingerprint|browser-ticket|browser-stage|browser-fingerprint)$ {
        if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ~ ^/api/collect/(browser-pairs/[A-Za-z0-9_-]+|browser-fingerprint/[A-Za-z0-9_-]+/status)$ {
        if ($request_method !~ ^(GET|OPTIONS)$) { return 405; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header Cache-Control no-store always;
    }
    location / { return 404; }
}
