{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hybridguard/mtc-experiment-fact-v2",
  "title": "Externally reviewed MTC fact sidecar; never model outputs",
  "description": "Exact App and Browser payload binding is required. Evidence references are local files reviewed upstream; file existence alone does not verify their assertions. No fact is inferred from MTC origin or fingerprint differences.",
  "type": "object",
  "required": [
    "fact_version",
    "sample_id",
    "app_session_id",
    "app_payload_sha256",
    "browser_payload_sha256",
    "source_kind",
    "label_status",
    "manipulation_present",
    "reference_status",
    "stable_identity_key",
    "identity_scope",
    "identity_status",
    "scenario_id",
    "scenario_phase",
    "scenario_repetition",
    "attack_family",
    "execution_status",
    "field_effect_status",
    "observable_target_fields",
    "evidence_refs",
    "phase_started_at_utc"
  ],
  "properties": {
    "fact_version": {
      "const": "mtc-experiment-fact-v2"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "app_session_id": {
      "type": "string",
      "minLength": 1
    },
    "app_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "browser_payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_kind": {
      "enum": [
        "collection_record",
        "controlled_intervention_record",
        "unknown"
      ]
    },
    "label_status": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "manipulation_present": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reference_status": {
      "enum": [
        "no_active_intervention_recorded",
        "unknown"
      ]
    },
    "stable_identity_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "identity_scope": {
      "enum": [
        "physical_device",
        "provider_device_profile",
        "device_profile",
        "unknown"
      ]
    },
    "identity_status": {
      "enum": [
        "verified",
        "unknown"
      ]
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "scenario_phase": {
      "enum": [
        "baseline",
        "attack_active",
        null
      ]
    },
    "scenario_repetition": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "attack_family": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "execution_status": {
      "enum": [
        "succeeded",
        "failed",
        "not_applicable",
        "unknown"
      ]
    },
    "field_effect_status": {
      "enum": [
        "observed",
        "not_observed",
        "no_configured_change",
        "unknown"
      ]
    },
    "observable_target_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "phase_started_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "UTC timestamp from the externally reviewed phase execution record; required for a declared scenario."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "label_status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "manipulation_present": {
            "type": "boolean"
          },
          "source_kind": {
            "enum": [
              "collection_record",
              "controlled_intervention_record"
            ]
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "stable_identity_key": {
            "type": "string",
            "minLength": 1
          },
          "identity_scope": {
            "enum": [
              "physical_device",
              "provider_device_profile",
              "device_profile"
            ]
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reference_status": {
            "const": "no_active_intervention_recorded"
          }
        }
      },
      "then": {
        "properties": {
          "source_kind": {
            "enum": [
              "collection_record",
              "controlled_intervention_record"
            ]
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
