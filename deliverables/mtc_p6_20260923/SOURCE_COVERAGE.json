      ],
      "scope": "widthPixels/heightPixels describe available display dimensions. The field named screen_resolution_physical is collected from resources.displayMetrics and must be interpreted as App reported display size. scaledDensity deprecated at API 34 because adaptive nonlinear font scaling invalidates simple scale assumptions.",
      "limitations": "Do not call this field native physical panel resolution or equate it with Display.Mode, Browser viewport, xdpi/ydpi or devicePixelRatio."
    },
